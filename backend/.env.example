# =========================
# Studysis Backend 示例配置
# 复制为 .env 后再按需修改
# =========================

# -------------------------
# 基础服务配置
# -------------------------

# 后端服务名称
APP_NAME=Studysis Backend

# 后端版本号
APP_VERSION=1.3.0

# API 前缀
API_V1_PREFIX=/api/v1

# 本地监听地址
HOST=127.0.0.1

# 本地监听端口
PORT=8000


# -------------------------
# AI 总开关
# -------------------------

# 是否启用 AI 能力
# 可选值：true / false
AI_ENABLED=false

# 当前使用的 AI Provider
# 可选值：none / local / cloud
AI_PROVIDER=none

# 单次 AI 请求超时时间（秒）
AI_TIMEOUT_SECONDS=30

# AI 生成温度
# 越低越稳定，越高越发散
AI_TEMPERATURE=0.2

# 单次生成的最大 token 数
AI_MAX_TOKENS=900

# 全局分章阶段最多送入 AI 的句群块数量
# 块数过多会显著拖慢首轮总览生成
AI_OUTLINE_MAX_BLOCKS=80

# 章节二次分析的并行度
# 建议 3~6，过高可能触发第三方接口限流
AI_CHAPTER_PARALLELISM=4


# -------------------------
# 本地模型（Ollama）配置
# -------------------------

# Ollama 服务地址
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 本地模型名称
# 例如：qwen2.5:7b / qwen3:8b / llama3.1:8b
OLLAMA_MODEL=qwen3:4b

# Ollama keep-alive 配置
OLLAMA_KEEP_ALIVE=15m


# -------------------------
# 第三方模型配置
# 需要兼容 OpenAI Chat Completions 接口
# -------------------------

# 第三方 API 基础地址
# 例如：https://api.openai.com/v1
CLOUD_API_BASE_URL=

# 第三方 API Key
CLOUD_API_KEY=

# 第三方模型名称
# 例如：gpt-4o-mini / deepseek-chat / qwen-max
CLOUD_API_MODEL=

# Chat Completions 路径
# 默认保持 /chat/completions 即可
CLOUD_API_PATH=/chat/completions

# 是否显式关闭推理模型的 thinking 输出
# 对智谱等第三方接口，建议保持 disabled
CLOUD_THINKING_TYPE=disabled

# 是否清空 thinking 痕迹
# 可选值：true / false
CLOUD_CLEAR_THINKING=true
